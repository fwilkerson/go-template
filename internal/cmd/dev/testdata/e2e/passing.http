### Page
GET {{host}}/

> {%
client.test("page", () => {
    client.assert(response.status === 200, "status");
    client.assert(response.body.includes("{{greeting}}") === false, "variables are not expanded in scripts");
    client.assert(response.body.includes("Hello"), "body");
});
%}

### Echo
POST {{host}}/echo
X-Retries: {{retries}}

{{greeting}}, echo

> {%
client.assert(response.body === "Hello, echo", "body echoes the expanded request body");
client.assert(response.headers.valueOf("X-Retries") === "3", "header expanded");
%}
